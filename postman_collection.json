    {
      "name": "Scholarships",
      "item": [
        {
          "name": "List Scholarships",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.next_cursor) {",
                  "    pm.environment.set(\"scholarship_cursor\", jsonData.data.next_cursor);",
                  "}",
                  "if (jsonData.success && jsonData.data.data && jsonData.data.data.length > 0) {",
                  "    pm.environment.set(\"scholarship_id\", jsonData.data.data[0].scholarship_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/students/me/scholarships?general_only=false&sort=deadline_asc&limit=30",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "students", "me", "scholarships"],
              "query": [
                {
                  "key": "type",
                  "value": "",
                  "description": "Optional: merit, need, athletic, demographic, major, other",
                  "disabled": true
                },
                {
                  "key": "college_id",
                  "value": "",
                  "description": "Optional saved college id",
                  "disabled": true
                },
                {
                  "key": "general_only",
                  "value": "false"
                },
                {
                  "key": "sort",
                  "value": "deadline_asc",
                  "description": "deadline_asc, deadline_desc, amount_desc"
                },
                {
                  "key": "limit",
                  "value": "30"
                },
                {
                  "key": "cursor",
                  "value": "{{scholarship_cursor}}",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "List General Scholarships Only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/students/me/scholarships?general_only=true&sort=deadline_asc&limit=30",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "students", "me", "scholarships"],
              "query": [
                {
                  "key": "general_only",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "deadline_asc"
                },
                {
                  "key": "limit",
                  "value": "30"
                }
              ]
            }
          }
        },
        {
          "name": "Get Scholarship Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/scholarships/{{scholarship_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "scholarships", "{{scholarship_id}}"]
            }
          }
        },
        {
          "name": "Save Scholarship",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.saved_scholarship_id) {",
                  "    pm.environment.set(\"saved_scholarship_id\", jsonData.data.saved_scholarship_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scholarship_id\": {{scholarship_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/students/me/scholarships/saved",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "students", "me", "scholarships", "saved"]
            }
          }
        },
